<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.quiz</groupId>
    <artifactId>quiz-multijoueur</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Version du serveur d'application cible : WildFly EE 10 (variante qui
             conserve les specifications Jakarta EE 10, cf. wildfly.org).
             Le BOM importe ci-dessous aligne automatiquement les versions
             de Hibernate/Jakarta Persistence/JMS/CDI, etc. sur exactement ce
             que fournit ce serveur, pour eviter toute incompatibilite au
             deploiement. -->
        <wildfly.ee.version>41.0.1.Final</wildfly.ee.version>

        <h2.version>2.2.224</h2.version>
        <junit.version>5.10.2</junit.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- BOM WildFly EE 10 : impose les memes versions de Jakarta Persistence,
                 Hibernate, JMS, CDI, EJB, Jackson, etc. que celles reellement
                 presentes sur le serveur. On evite ainsi de declarer nous-memes
                 des versions qui pourraient differer de celles du serveur au
                 moment du deploiement. -->
            <dependency>
                <groupId>org.wildfly.bom</groupId>
                <artifactId>wildfly-ee-with-tools</artifactId>
                <version>${wildfly.ee.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>

        <!-- ===================== Persistance (JPA) ===================== -->

        <!-- Specification JPA (utilisee par les entites @Entity, EntityManager, etc.).
             Version geree par le BOM WildFly ci-dessus. -->
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
        </dependency>

        <!-- Implementation JPA : Hibernate.
             scope=provided : WildFly fournit deja Hibernate sur le serveur,
             inutile (et risque de conflit) de l'embarquer dans notre .war.
             Reste disponible en compilation et pour "mvn test" en local. -->
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-core</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- ===================== Messagerie (JMS) et injection ===================== -->

        <!-- API JMS (topics, JMSContext...), utilisee par JmsRoomEventPublisher.
             Fournie par WildFly au moment du deploiement. -->
        <dependency>
            <groupId>jakarta.jms</groupId>
            <artifactId>jakarta.jms-api</artifactId>
            <version>3.1.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- CDI : necessaire pour l'injection @Inject de JMSContext dans
             JmsRoomEventPublisher. Fournie par WildFly. -->
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
            <version>4.0.1</version>
            <scope>provided</scope>
        </dependency>

        <!-- Annotation @Inject elle-meme. Fournie par WildFly. -->
        <dependency>
            <groupId>jakarta.inject</groupId>
            <artifactId>jakarta.inject-api</artifactId>
            <version>2.0.1</version>
            <scope>provided</scope>
        </dependency>

        <!-- ===================== Serialisation JSON ===================== -->

        <!-- Serialisation JSON des evenements JMS (voir EvenementJms,
             JmsRoomEventPublisher : {"type": "...", "data": {...}}).
             scope=provided : WildFly embarque deja Jackson, version geree
             par le BOM ci-dessus. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- ===================== Base de donnees locale et tests ===================== -->

        <!-- Base de donnees H2 en memoire : sert uniquement au developpement/tests locaux,
             sans avoir besoin d'installer PostgreSQL tout de suite -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>${h2.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

<!-- API WebSocket-->
 
        <dependency>
    <groupId>jakarta.websocket</groupId>
    <artifactId>jakarta.websocket-api</artifactId>
    <version>2.1.1</version>
   <!--  <scope>provided</scope>  ty mbola eritreretina -->
     <scope>compile</scope>
</dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>

            <!-- A activer quand le projet passera en packaging "war" pour le
                 deploiement reel sur WildFly (voir README) :

            <plugin>
                <groupId>org.wildfly.plugins</groupId>
                <artifactId>wildfly-maven-plugin</artifactId>
                <version>4.2.2.Final</version>
            </plugin>
            -->
        </plugins>
    </build>
</project>