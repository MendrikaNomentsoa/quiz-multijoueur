<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
             https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd"
             version="3.1">

    <!--
        Unite de persistance "quizPU-local" :
        H2 en memoire, pour que chaque developpeur puisse coder et tester
        des maintenant, sans avoir besoin d'installer PostgreSQL ni de
        serveur d'application. Le schema est recree a chaque lancement
        (hbm2ddl.auto=create-drop) et les donnees de test (import.sql)
        sont chargees automatiquement.

        Sur le serveur d'application final (WildFly / Payara), une
        deuxieme unite de persistance "quizPU" pointera vers un
        DataSource JNDI connecte a PostgreSQL - a ajouter le moment venu,
        sans toucher aux entites.
    -->
    <persistence-unit name="quizPU-local" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>com.quiz.model.Theme</class>
        <class>com.quiz.model.Quiz</class>
        <class>com.quiz.model.Question</class>
        <class>com.quiz.model.Choix</class>
        <class>com.quiz.model.Room</class>
        <class>com.quiz.model.Participant</class>
        <class>com.quiz.model.Reponse</class>

        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver"/>
            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:h2:mem:quizdb;DB_CLOSE_DELAY=-1"/>
            <property name="jakarta.persistence.jdbc.user" value="sa"/>
            <property name="jakarta.persistence.jdbc.password" value=""/>

            <property name="hibernate.hbm2ddl.auto" value="create-drop"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
            <property name="hibernate.hbm2ddl.import_files" value="import.sql"/>

            <!-- Convertit les champs Java camelCase (ex: dureeReponseMs) en colonnes
                 snake_case (ex: duree_reponse_ms), pour correspondre a import.sql -->
            <property name="hibernate.physical_naming_strategy"
                      value="org.hibernate.boot.model.naming.CamelCaseToUnderscoresNamingStrategy"/>
        </properties>
    </persistence-unit>

</persistence>
